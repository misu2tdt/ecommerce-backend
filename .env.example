# Basic local backend configuration
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=ecommerce-local-only
DB_NAME=ecommerce_dev
DEV_DB_HOST_PORT=5434
DEV_DB_CONTAINER_NAME=ecom_db
DEV_DB_VOLUME_NAME=ecommerce_postgres_data
DEV_DB_COMPOSE_PROJECT=ecommerce-local
JWT_SECRET=local-development-only-change-before-deploying
JWT_EXPIRES_IN=15m

# Optional integrations. These placeholders allow local bootstrap but do not
# enable provider access. Replace only when intentionally testing a provider.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

PAYMENT_CURRENCY=VND
MOMO_PARTNER_CODE=local-disabled
MOMO_ACCESS_KEY=local-disabled
MOMO_SECRET_KEY=local-disabled
# Required stable application secret for opaque MoMo order/request IDs; do not reuse MOMO_SECRET_KEY.
MOMO_IDENTITY_SECRET=local-development-identity-only
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:3001/payment-return
MOMO_IPN_URL=http://localhost:3000/payments/webhooks/momo
